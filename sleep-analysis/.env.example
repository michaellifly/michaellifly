# ---------------------------------------------------------------
# Baby Tracker - Newborn Log (Nighp) — data connection
# ---------------------------------------------------------------

# OPTION A: SQLite database (recommended — most complete data)
#
# Steps to get EasyLog.db on a Mac:
#   1. iPhone → Baby Tracker → Settings → Link to Cloud → iCloud (enable)
#   2. Wait ~1 min for sync
#   3. Mac → Finder → Go → Go to Folder → paste:
#        ~/Library/Mobile Documents/iCloud~com~nighp~babytracker/Documents/
#   4. Copy EasyLog.db here
#
# Alternative (iPhone only, no Mac):
#   iPhone → Baby Tracker → Settings → Export Data Clone → Email to yourself
#   Open the email, save the attachment, unzip → find EasyLog.db inside
#
BT_DB_FILE=EasyLog.db

# OPTION B: JSON or CSV export file
#   iPhone → Baby Tracker → Settings → Export Report (CSV/PDF)
#   For CSV: save file and point to it here
#
# BT_DATA_FILE=my_export.csv

# Your local timezone (IANA format)
BT_TIMEZONE=America/New_York

# Baby's name (if account has multiple babies)
# BT_BABY_NAME=Emma
